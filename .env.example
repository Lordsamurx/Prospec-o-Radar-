# Radar (v3). Copie para .env e preencha. NUNCA coloque chaves em outro lugar.
# O que faltar aqui, a v3 busca no .env do protótipo (pasta de cima), só estas chaves:
# GOOGLE_MAPS_API_KEY, PLACES_PROVIDER, MAX_PLACES_REQUESTS_PER_DAY, APP_USER, APP_PASSWORD, BASE_URL.

# Fonte dos dados: osm (grátis, padrão) | google (precisa de chave e faturamento) | mock (fictícios)
PLACES_PROVIDER=osm
GOOGLE_MAPS_API_KEY=
MAX_PLACES_REQUESTS_PER_DAY=30

# Banco de dados. No Windows, deixe FORA do OneDrive:
# DATABASE_URL=sqlite:///C:/dev/prospeccao-data/radar.db
DATABASE_URL=sqlite:///./data/radar.db

# Endereço da app e das amostras
BASE_URL=http://localhost:8000
# Endereço público das amostras (Cloudflare Pages), ex.: https://meu-projeto.pages.dev
PREVIEWS_PUBLIC_URL=
CLOUDFLARE_PAGES_PROJECT=

# IA para deixar a mensagem mais natural (opcional; sem chave usa o texto padrão)
GEMINI_API_KEY=
GROQ_API_KEY=
# Teste de velocidade do site do lead (opcional)
PAGESPEED_API_KEY=

# Senha: preencha só se a app ficar na internet
APP_USER=samuel
APP_PASSWORD=
